<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log rotation launchd template — installed by scripts/native-service.sh.

  The agents write to /tmp with no rotation. Over one eleven-day window the
  Ollama sidecar's stderr reached 262 MB and the engine's own log 72 MB, and
  because /tmp survives only a single reboot, the history most useful during an
  incident is also the history most likely to be gone. Rotating into gzipped
  generations keeps much more history in much less space.

  Like the tunnel probe this is a periodic one-shot rather than a daemon:
  ``StartInterval`` re-runs it and ``KeepAlive=false`` lets it exit. Hourly is
  ample — rotation is size-triggered, so the interval only bounds how far past
  the threshold a very chatty log can get before it is trimmed.

  Path/value substitutions performed at install time:

      __PROJECT_DIR__    absolute path to the repository root.
      __VENV_PYTHON__    absolute path to the project venv's python3.
      __HOME__           the installing user's home directory.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.planeon.log-rotate</string>

    <!-- Run under the venv interpreter, not /bin/bash. When the repository
         lives under a TCC-protected directory (~/Desktop, ~/Documents) the
         shell launchd spawns cannot even read a script there — it fails with
         `Operation not permitted` and exit 126. The venv interpreter already
         holds the Full Disk Access grant the engine agent depends on. -->
    <key>ProgramArguments</key>
    <array>
        <string>__VENV_PYTHON__</string>
        <string>__PROJECT_DIR__/scripts/rotate_logs.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <!-- 64 MiB per live log, five gzipped generations behind it. The
             sidecar compresses roughly 20:1, so this bounds the whole set at
             well under 100 MB while holding far more history than the single
             unbounded file it replaces. -->
        <key>PLANEON_LOG_MAX_BYTES</key>
        <string>67108864</string>
        <key>PLANEON_LOG_KEEP</key>
        <string>5</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Deliberately not /tmp/planeon-*.log: the rotator must not rotate its
         own log out from under itself mid-run. -->
    <key>StandardOutPath</key>
    <string>/tmp/planeon-logrotate.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/planeon-logrotate.err</string>
</dict>
</plist>
