    {
      "type": "timeseries",
      "title": "Requests/sec by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total[${__rate_interval}]))",
          "legendFormat": "{{span_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
