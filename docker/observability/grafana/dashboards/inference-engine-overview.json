    {
      "type": "timeseries",
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "In flight / queued by tenant (live)",
      "description": "Scraped straight off the engine's /v1/metrics, so it is visible within one scrape interval. The scheduler increments these AT ADMISSION, before the model is called.\n\nEvery other traffic panel is derived from spans, and a span does not exist until the request COMPLETES -- so on a p50 of ~36s those panels cannot show a request that is still generating. This panel can. Use it to answer \"did my request land?\"; use the rate panels for throughput.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (tenant) (inference_engine_scheduler_in_flight_by_tenant)",
          "legendFormat": "{{tenant}} \u00b7 in flight",
          "refId": "A"
        },
        {
          "expr": "sum by (tenant) (inference_engine_scheduler_queued_by_tenant)",
          "legendFormat": "{{tenant}} \u00b7 queued",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Request rate breakdowns",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
