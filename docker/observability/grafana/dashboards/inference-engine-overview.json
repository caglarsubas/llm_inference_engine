            "last",
            "max",
            "mean"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (prometa_tenant) (increase(traces_spanmetrics_calls_total{span_name=~\"chat[.].*|completions[.]run|embeddings[.]run|rerank[.]run\"}[${__rate_interval}]))",
          "legendFormat": "{{prometa_tenant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max",
            "sum"
          ]
        }
      },
      "description": "increase(), not rate(), because this deployment's per-tenant traffic sits around 0.02 req/s and a rate over $__rate_interval (60s at a 15s scrape) renders a SINGLE request as 0.022 req/s smeared into a 60s trapezoid -- a number that reads like throughput but is really 1/45s, the gap between the two samples Prometheus found.\n\nCounts answer the question this panel is actually asked. Prometheus still extrapolates increase() to the window edges, so a lone request can read slightly above 1.\n\nDerived from spans, so it lags a completed request by ~20-30s through the collector pipeline and shows nothing while a request is still generating. For that, see 'In flight / queued by tenant (live)'."
    },
